# Scenario 01 — Possible DNS Reconnaissance
# Detection Engineer: Sonia
# Detection version: 1.0
# MITRE ATT&CK: T1590.002 — Gather Victim Network Information: DNS
# Final threshold derived from the implemented baseline + controlled validation.

index=dns_soc_aws sourcetype="aws:kinesis"
| rex field=_raw "^(?<log_version>\S+)\s+(?<route53_event_time>\S+)\s+(?<hosted_zone_id>\S+)\s+(?<query_name>\S+)\s+(?<query_type>\S+)\s+(?<response_code>\S+)\s+(?<protocol>\S+)\s+(?<edge_location>\S+)\s+(?<observed_dns_source>\S+)\s+(?<edns_client_subnet>\S+)"
| eval query_name=lower(rtrim(query_name,"."))
| where query_name="soclab.abdul4rehman215.tech"
    OR match(query_name,"\.soclab\.abdul4rehman215\.tech$")

| eval event_epoch=_time

| stats min(event_epoch) as first_event
        max(event_epoch) as last_event
        count as query_count
        dc(query_name) as unique_names
        dc(query_type) as distinct_query_types
        values(query_type) as query_types
        values(query_name) as query_name_samples
        values(response_code) as response_codes
        count(eval(response_code="NXDOMAIN")) as nxdomain_count
  by observed_dns_source

| where query_count>=16
    AND unique_names>=4
    AND distinct_query_types>=3

| eval detection_name="Scenario 01 - Possible DNS Reconnaissance"
| eval detection_version="1.1"
| eval mitre_technique="T1590.002"
| eval severity="medium"
| eval rationale="Concentrated DNS activity against controlled lab namespace with query-name and record-type diversity within the scheduled detection window"

| eval scenario_id="scenario-01-dns-recon"
| eval scenario_name="DNS Reconnaissance & Enumeration"
| eval ai_profile="dns_recon_v1"

| eval alert_id=scenario_id . "-" . replace(observed_dns_source,"\." ,"-") . "-" . strftime(first_event,"%Y%m%dT%H%M%SZ")
| eval alert_name=detection_name
| eval scenario=scenario_name
| eval event_time=strftime(first_event,"%Y-%m-%dT%H:%M:%SZ")
| eval source=observed_dns_source

| eval query_types_text=mvjoin(query_types,",")
| eval query_names_text=mvjoin(query_name_samples,",")
| eval response_codes_text=mvjoin(response_codes,",")

| eval evidence_json=json_object(
    "scenario_id",scenario_id,
    "ai_profile",ai_profile,
    "detection_version",detection_version,
    "observed_dns_source",observed_dns_source,
    "query_count",query_count,
    "unique_names",unique_names,
    "distinct_query_types",distinct_query_types,
    "query_types",query_types_text,
    "query_name_samples",query_names_text,
    "response_codes",response_codes_text,
    "nxdomain_count",nxdomain_count,
    "mitre_technique",mitre_technique,
    "rationale",rationale
)

| eval first_event_display=strftime(first_event,"%Y-%m-%d %H:%M:%S UTC")
| eval last_event_display=strftime(last_event,"%Y-%m-%d %H:%M:%S UTC")

| table alert_id
        alert_name
        scenario
        severity
        event_time
        source
        evidence_json
        scenario_id
        scenario_name
        ai_profile
        detection_name
        detection_version
        first_event_display
        last_event_display
        observed_dns_source
        query_count
        unique_names
        distinct_query_types
        query_types
        query_name_samples
        response_codes
        nxdomain_count
        mitre_technique
        rationale
